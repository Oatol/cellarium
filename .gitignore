# WorkBuddy project data: keep locally, never publish
.workbuddy-ai/

# Local-only / not in the first docs-only backup
preview/
*.docx
*.apk
*.dex
*.substrate
analysis/cell_lab_apk_extract/*/assets/
analysis/cell_lab_apk_extract/*/classes.dex
analysis/cell_lab_apk_extract/*/AndroidManifest.xml
analysis/cell_lab_apk_extract/*/levels.xml

# Godot generated files
.godot/
**/.godot/
*.import
!godot/cellarium-release/assets/**/*.import
export_presets.cfg
# Local MCP plugin/bootstrap payload (install separately from its official release)
godot/cellarium-release/addons/
godot/cellarium-release/install.cmd
godot/cellarium-release/install.ps1
godot/cellarium-release/SOURCE.txt

# Historical Godot snapshots/backups kept locally; only godot/cellarium-release is the publish snapshot
godot/backup_*/
godot/backup_project_godot_*
godot/cellarium/
godot/cellarium-public/
godot/cellarium-snapshot/
# APK extraction scratch dirs (decompiled intermediates, never publish)
analysis/cell_lab_apk_extract/tmp_*/
analysis/cell_lab_apk_extract/decompiled_zh/
analysis/cell_lab_apk_extract/decompiled_macro/
analysis/cell_lab_apk_extract/*.log
analysis/cell_lab_apk_extract/mcp_*.py

# OS / editor noise
Thumbs.db
.DS_Store
*.swp
*~

# GDExtension: version C++ source, config and shipped DLL for traceability;
# keep only compiler intermediates / third-party checkout local.
*.dll
!godot/cellarium-release/bin/windows/cellarium_native.windows.template_debug.x86_64.dll
*.gdextension
!godot/cellarium-release/bin/cellarium_native.gdextension
*.obj
*.exp
*.lib
.sconsign.dblite
native/godot-cpp/
native/build/
godot/cellarium-release/addons/*/bin/
